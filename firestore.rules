rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function admin() { return request.auth != null && request.auth.token.email in ['PUT_YOUR_ADMIN_EMAIL_HERE']; }
    function me(u) { return request.auth != null && request.auth.uid == u; }
    match /users/{u} {
      allow read: if me(u) || admin();
      allow create: if me(u) && request.resource.data.status == 'new';
      allow update: if admin() || (me(u) && (request.resource.data.status == resource.data.status || (request.resource.data.status == 'pending' && resource.data.status in ['new', 'rejected'])));
    }
    match /biz/{u} { allow read, write: if me(u) || admin(); }
    match /bizPublic/{u} { allow read: if true; allow write: if me(u) || admin(); }
    match /chats/{c} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; }
    match /handover/{h} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid; }
    match /inbox/{i} { allow create: if request.resource.data.keys().hasOnly(['uid','body','sig','done','at']) && request.resource.data.body.size() < 20000 && request.resource.data.done == false; }
    match /ads/{a} { allow read: if request.auth != null; allow write: if admin(); }
    match /admin/{d} { allow read, write: if admin(); }
  }
}
